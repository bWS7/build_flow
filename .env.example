# Banco de dados (Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Flask
SECRET_KEY=gere-uma-chave-forte-e-unica
FLASK_ENV=production

# CORS do Socket.IO (dominios separados por virgula; vazio = qualquer origem)
ALLOWED_ORIGINS=
SOCKETIO_ASYNC_MODE=eventlet

# Admin inicial (opcional). Sem essas tres variaveis, nenhum admin e criado
# automaticamente no primeiro boot.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=troque-por-uma-senha-forte
SEED_ADMIN_NAME=Admin

# Assistente analitica "Kamille" (opcional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ANALYTICS_STYLE=analitico_comercial_financeiro
